@using RugsManagment.Application.DTOs.Tenants
@using RugsManagment.Application.DTOs.Workflows
@using RugsManagment.Domain.Enums
@using RugsManagment.Web.Support
@model TenantSettingsDto
@{
    ViewData["Title"] = "تنظیمات کارگاه";
    var templates = ViewData["Templates"] as IReadOnlyList<WorkflowTemplateDto> ?? [];
}

<div class="mx-auto max-w-2xl space-y-5">
    <div>
        <h1 class="text-2xl font-bold">تنظیمات کارگاه</h1>
        <p class="text-sm text-on-surface-variant">
            مشخصاتی که در برچسب‌ها، گزارش‌ها و سربرگ چاپ دیده می‌شود.
        </p>
    </div>

    @* وضعیت اشتراک — اطلاعاتی که کاربر باید بداند ولی نمی‌تواند خودش عوض کند *@
    <div class="rounded-xl border p-4 text-sm @(Model.IsExpired
             ? "border-error/40 bg-error-container text-on-error-container"
             : Model.DaysUntilExpiry is <= 14
                 ? "border-warning/40 bg-warning/10 text-warning"
                 : "border-outline-variant bg-surface-container-lowest")">
        <div class="flex items-start gap-2">
            <icon name="@(Model.IsExpired ? "error" : Model.DaysUntilExpiry is <= 14 ? "warning" : "info")" class="mt-0.5 h-5 w-5" />
            <div>
                <p class="font-medium">وضعیت اشتراک</p>
                @if (Model.SubscriptionExpiresAt is null)
                {
                    <p class="text-on-surface-variant">اشتراک بدون تاریخ انقضا.</p>
                }
                else if (Model.IsExpired)
                {
                    <p>اشتراک در @PersianFormat.DateLong(Model.SubscriptionExpiresAt) به پایان رسیده است.</p>
                }
                else
                {
                    <p data-numeric>
                        تا @PersianFormat.DateLong(Model.SubscriptionExpiresAt)
                        (@PersianFormat.Count(Model.DaysUntilExpiry ?? 0) روز باقی مانده)
                    </p>
                }
                <p class="mt-1 text-xs text-on-surface-variant">
                    برای تمدید یا تغییر اشتراک با پشتیبانی تماس بگیرید.
                </p>
            </div>
        </div>
    </div>

    <!-- لوگو -->
    <section class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
        <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold text-primary">
            <icon name="image" class="h-4 w-4" />
            لوگوی کارگاه
        </h2>

        <div class="flex flex-wrap items-center gap-4">
            <span class="grid h-20 w-20 shrink-0 place-items-center overflow-hidden rounded-lg border border-outline-variant bg-surface-container text-on-surface-variant">
                @if (Model.LogoUrl is string logo)
                {
                    <img src="@logo" alt="لوگوی @Model.Name" width="80" height="80" class="h-full w-full object-contain" />
                }
                else
                {
                    <icon name="image" class="h-8 w-8" />
                }
            </span>

            <form asp-action="Logo" method="post" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="file" name="file" accept="image/png,image/jpeg,image/webp" required
                       class="max-w-[16rem] text-sm file:me-3 file:min-h-11 file:rounded-lg file:border file:border-outline-variant file:bg-surface-container file:px-3 file:text-sm" />
                <button type="submit"
                        class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-4 text-sm hover:bg-surface-container">
                    <icon name="check" class="h-4 w-4" />
                    آپلود
                </button>
            </form>

            @if (Model.LogoUrl is not null)
            {
                <form asp-action="Logo" method="post"
                      data-confirm="لوگو حذف شود؟" data-confirm-label="حذف لوگو" data-confirm-danger>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="remove" value="true" />
                    <button type="submit"
                            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-4 text-sm text-error hover:bg-error-container">
                        <icon name="trash" class="h-4 w-4" />
                        حذف
                    </button>
                </form>
            }
        </div>

        <p class="mt-3 text-xs text-on-surface-variant">
            فرمت PNG، JPEG یا WebP — حداکثر ۲ مگابایت. ترجیحاً پس‌زمینهٔ شفاف.
        </p>
    </section>

    <!-- مشخصات -->
    <form asp-action="Tenant" method="post" class="space-y-5">
        @Html.AntiForgeryToken()

        <section class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
            <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold text-primary">
                <icon name="building" class="h-4 w-4" />
                مشخصات
            </h2>

            <div class="grid gap-4 sm:grid-cols-2">
                <label class="block sm:col-span-2">
                    <span class="mb-1 block text-sm font-medium">نام کارگاه</span>
                    <input name="name" value="@Model.Name" required
                           class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                </label>

                <label class="block">
                    <span class="mb-1 block text-sm font-medium">تلفن تماس</span>
                    <input name="contactPhone" value="@Model.ContactPhone" dir="ltr"
                           class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                </label>

                <label class="block">
                    <span class="mb-1 block text-sm font-medium">ایمیل تماس</span>
                    <input name="contactEmail" value="@Model.ContactEmail" dir="ltr" type="email"
                           class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
                </label>

                <div class="sm:col-span-2">
                    <span class="mb-1 block text-sm font-medium">شناسهٔ یکتا</span>
                    <p class="font-mono text-sm text-on-surface-variant" dir="ltr">@Model.Slug</p>
                    <p class="text-xs text-on-surface-variant">این شناسه ثابت است و تغییر نمی‌کند.</p>
                </div>
            </div>
        </section>

        <section class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
            <h2 class="mb-4 flex items-center gap-2 text-sm font-semibold text-primary">
                <icon name="settings" class="h-4 w-4" />
                پیش‌فرض‌ها
            </h2>

            <div class="grid gap-4 sm:grid-cols-2">
                <label class="block">
                    <span class="mb-1 block text-sm font-medium">واحد پول</span>
                    <select name="currency"
                            class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary">
                        <option value="@((int)CurrencyUnit.Toman)" selected="@(Model.Currency == CurrencyUnit.Toman)">تومان</option>
                        <option value="@((int)CurrencyUnit.Rial)" selected="@(Model.Currency == CurrencyUnit.Rial)">ریال</option>
                    </select>
                    @* هشدار صریح: این فقط برچسب است و هیچ عددی را تبدیل نمی‌کند *@
                    <span class="mt-1 block text-xs text-warning">
                        تغییر واحد فقط برچسب نمایش را عوض می‌کند و مبالغ ثبت‌شده را تبدیل نمی‌کند.
                    </span>
                </label>

                <label class="block">
                    <span class="mb-1 block text-sm font-medium">قالب گردش کار پیش‌فرض</span>
                    <select name="defaultWorkflowTemplateId"
                            class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary">
                        <option value="">— بدون پیش‌فرض —</option>
                        @foreach (var t in templates)
                        {
                            <option value="@t.Id" selected="@(Model.DefaultWorkflowTemplateId == t.Id)">@t.Name</option>
                        }
                    </select>
                    <span class="mt-1 block text-xs text-on-surface-variant">
                        هنگام ثبت فرش جدید از پیش انتخاب می‌شود.
                    </span>
                </label>
            </div>
        </section>

        <div class="flex justify-end">
            <button type="submit"
                    class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 font-semibold text-on-primary hover:bg-primary-hover">
                <icon name="check" class="h-5 w-5" />
                ذخیرهٔ تنظیمات
            </button>
        </div>
    </form>
</div>
