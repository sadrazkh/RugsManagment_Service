@model IReadOnlyList<RugsManagment.Application.DTOs.Auth.UserDto>
@{
    ViewData["Title"] = "کاربران کارگاه";
    string RoleFa(string r) => r switch
    {
        "TenantAdmin" => "مدیر کارگاه",
        "Operator" => "اپراتور",
        _ => r
    };
}

<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-bold">کاربران کارگاه</h1>
        <a asp-action="Create"
           class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-semibold text-on-primary hover:bg-primary-hover">
            <icon name="plus" class="h-5 w-5" />
            کاربر جدید
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest p-12 text-center">
            <span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-surface-container text-on-surface-variant">
                <icon name="users" class="h-7 w-7" />
            </span>
            <p class="font-medium text-on-surface">هنوز کاربری اضافه نشده است</p>
            <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                برای اپراتورهای کارگاه حساب بسازید تا بتوانند مراحل فرش‌ها را ثبت کنند.
            </p>
            <a asp-action="Create"
               class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 font-semibold text-on-primary hover:bg-primary-hover">
                <icon name="plus" class="h-5 w-5" />
                افزودن کاربر
            </a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-outline-variant bg-surface-container-lowest">
            <table class="w-full text-sm">
                <caption class="sr-only">فهرست کاربران کارگاه با نقش و ایمیل</caption>
                <thead class="bg-surface-container text-on-surface-variant">
                    <tr>
                        <th scope="col" class="p-3 text-right font-medium">نام</th>
                        <th scope="col" class="hidden p-3 text-right font-medium sm:table-cell">ایمیل</th>
                        <th scope="col" class="p-3 text-right font-medium">نقش</th>
                        <th scope="col" class="p-3"><span class="sr-only">عملیات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr class="border-t border-outline-variant transition-colors even:bg-surface-container-low/60 hover:bg-surface-container/70">
                            <td class="p-3 font-medium">@u.FullName</td>
                            <td class="hidden p-3 text-on-surface-variant sm:table-cell" dir="ltr">@u.Email</td>
                            <td class="p-3">
                                <span class="rounded-full bg-secondary-container px-2.5 py-1 text-xs text-on-secondary-container">@RoleFa(u.Role)</span>
                            </td>
                            <td class="p-3 text-left">
                                <a asp-action="Edit" asp-route-id="@u.Id"
                                   class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-outline-variant px-3 text-xs hover:bg-surface-container">
                                    <icon name="edit" class="h-4 w-4" />
                                    ویرایش
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
