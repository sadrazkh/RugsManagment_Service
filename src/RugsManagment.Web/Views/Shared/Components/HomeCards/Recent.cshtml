@using RugsManagment.Web.Home.Cards
@using RugsManagment.Web.Navigation
@model HomeRecentModel
@* کارهای اخیر کارگاه؛ برای غیر Business رویدادهای پولی از پیش در سرویس خلاصه حذف شده‌اند. *@
<section class="h-full rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm"
         aria-labelledby="home-recent-title">
    <div class="flex items-center justify-between gap-3">
        <h2 id="home-recent-title" class="flex items-center gap-2 text-base font-semibold text-primary">
            <icon name="info" class="h-5 w-5" />
            کارهای اخیر
        </h2>
        @if (Model.ActivityHref is not null)
        {
            <a href="@NavBuilder.Resolve(Context, Model.ActivityHref)"
               class="inline-flex min-h-11 items-center gap-1 rounded-lg px-3 text-sm text-on-surface-variant hover:bg-surface-container">
                همه
                <icon name="chevron-left" class="h-4 w-4" />
            </a>
        }
    </div>

    <ol class="mt-3 divide-y divide-outline-variant">
        @foreach (var entry in Model.Entries)
        {
            <li class="flex items-start gap-3 py-3">
                <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-surface-container text-on-surface-variant">
                    <icon name="@HomeRecentModel.IconFor(entry.Action)" class="h-4 w-4" />
                </span>
                <div class="min-w-0 flex-1">
                    <p class="break-words">@entry.Summary</p>
                    <p class="text-sm text-on-surface-variant" data-numeric>
                        @entry.UserName ·
                        <time datetime="@entry.CreatedAt.ToString("O")">@PersianFormat.Relative(entry.CreatedAt)</time>
                    </p>
                </div>
            </li>
        }
    </ol>
</section>
