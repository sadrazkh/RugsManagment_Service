@using RugsManagment.Application.DTOs.Rugs
@model IReadOnlyList<DeletedRugDto>
@{
    ViewData["Title"] = "سطل زباله";
}

<div class="space-y-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex items-center gap-3">
            @* در RTL «بازگشت» به سمت راست اشاره می‌کند *@
            <a asp-action="Index"
               class="grid h-11 w-11 place-items-center rounded-lg border border-outline-variant hover:bg-surface-container">
                <icon name="arrow-right" label="بازگشت به فهرست فرش‌ها" />
            </a>
            <div>
                <h1 class="text-2xl font-bold">سطل زباله</h1>
                <p class="text-sm text-on-surface-variant">
                    فرش‌های حذف‌شده اینجا می‌مانند. مراحل، هزینه‌ها و عکس‌هایشان دست‌نخورده است.
                </p>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest p-12 text-center">
            <span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-surface-container text-on-surface-variant">
                <icon name="trash" class="h-7 w-7" />
            </span>
            <p class="font-medium text-on-surface">سطل زباله خالی است</p>
            <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                هر فرشی که حذف کنید اینجا می‌آید و می‌توانید بازگردانیدش.
            </p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-xl border border-outline-variant bg-surface-container-lowest">
            <table class="w-full text-sm">
                <caption class="sr-only">فرش‌های حذف‌شده، تازه‌ترین اول</caption>
                <thead class="bg-surface-container text-on-surface-variant">
                    <tr>
                        <th scope="col" class="p-3 text-right font-medium">کد / نام</th>
                        <th scope="col" class="hidden p-3 text-right font-medium sm:table-cell">ابعاد</th>
                        <th scope="col" class="hidden p-3 text-right font-medium md:table-cell">هزینهٔ ثبت‌شده</th>
                        <th scope="col" class="p-3 text-right font-medium">حذف شده</th>
                        <th scope="col" class="p-3"><span class="sr-only">عملیات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rug in Model)
                    {
                        <tr class="border-t border-outline-variant transition-colors even:bg-surface-container-low/60 hover:bg-surface-container/70">
                            <td class="p-3">
                                <div class="font-medium">@(string.IsNullOrWhiteSpace(rug.Title) ? "بدون نام" : rug.Title)</div>
                                <div class="font-mono text-xs text-on-surface-variant" dir="ltr">@rug.Sku</div>
                            </td>
                            <td class="hidden p-3 text-on-surface-variant sm:table-cell">
                                @PersianFormat.Number(rug.WidthMeters)×@PersianFormat.Number(rug.LengthMeters)
                            </td>
                            <td class="hidden p-3 md:table-cell">@Tenant.Money(rug.TotalInvestment)</td>
                            <td class="p-3 text-on-surface-variant">
                                <div>@PersianFormat.Date(rug.DeletedAt)</div>
                                @if (!string.IsNullOrWhiteSpace(rug.DeletedByName))
                                {
                                    <div class="text-xs">توسط @rug.DeletedByName</div>
                                }
                            </td>
                            <td class="p-3 text-left">
                                <form asp-action="Restore" asp-route-id="@rug.Id" method="post">
                                    <button type="submit"
                                            class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-outline-variant px-3 text-xs hover:bg-surface-container">
                                        <icon name="undo" class="h-4 w-4" />
                                        بازگردانی
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-xs text-on-surface-variant">
            حذف نهایی از این صفحه انجام نمی‌شود؛ رکورد برای حسابرسی و تسویهٔ استادکارها نگه داشته می‌شود.
        </p>
    }
</div>
