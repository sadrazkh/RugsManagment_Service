@using System.Text.Json
@using RugsManagment.Application.DTOs.Rugs
@using RugsManagment.Web.Auth
@using RugsManagment.Web.Support
@model RugDto
@inject IUserPreferencesAccessor Prefs
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Title) ? Model.Sku : Model.Title;

    // نمای ساده: وضعیت کارگاهی جای خود را به «کجاست» می‌دهد، کارهای کارگاه جمع‌شده می‌آید و کلید فیلدهای
    // سفارشیِ بی‌برچسب نشان داده نمی‌شود. فقط پوسته است؛ دسترسی همان می‌ماند.
    var simple = Prefs.IsSimple;
    var st = DisplayHelpers.RugStatus(Model.Status, simple);

    // مبلغ‌ها فقط برای Business. سرویس برای انباردار خلاصهٔ هزینه را null می‌فرستد؛ این‌جا خودِ بخش‌های پولی
    // (خلاصهٔ مالی، جزیرهٔ فروش) هم برایش رندر نمی‌شوند.
    var showMoney = Tenant.CanSeeMoney;
    var canTrash = Policies.IsBusiness(User);

    var labels = ViewData["CustomFieldLabels"] as Dictionary<string, string> ?? new();

    Dictionary<string, JsonElement> metadata = new();
    if (!string.IsNullOrWhiteSpace(Model.MetadataJson))
    {
        try { metadata = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(Model.MetadataJson) ?? new(); }
        catch { /* متادیتای خراب نباید صفحه را بشکند */ }
    }

    // کلید بی‌برچسب (فیلدی که حذف شده) در نمای ساده دیده نمی‌شود؛ بازرگان کلید انگلیسی نمی‌بیند
    var customValues = metadata
        .Where(kv => !simple || labels.ContainsKey(kv.Key))
        .ToList();
}

<div class="space-y-5">
    <!-- سربرگ -->
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex items-center gap-3">
            @* در RTL «بازگشت» به سمت راست اشاره می‌کند *@
            <a asp-action="Index"
               class="grid h-11 w-11 place-items-center rounded-lg border border-outline-variant hover:bg-surface-container">
                <icon name="arrow-right" label="بازگشت به فهرست فرش‌ها" />
            </a>
            <div>
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="text-2xl font-bold">@ViewData["Title"]</h1>
                    <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs @st.Css">
                        <icon name="@st.Icon" class="h-3.5 w-3.5" />
                        @st.Label
                    </span>
                </div>
                <div class="font-mono text-sm text-on-surface-variant" dir="ltr">@Model.Sku</div>
            </div>
        </div>

        <div class="flex flex-wrap gap-2">
            <a asp-controller="Labels" asp-action="Print" asp-route-rugIds="@Model.Id"
               class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-4 hover:bg-surface-container">
                <icon name="printer" class="h-5 w-5" />
                چاپ برچسب
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-semibold text-on-primary hover:bg-primary-hover">
                <icon name="edit" class="h-5 w-5" />
                ویرایش
            </a>

            @* حذف کار بازرگان و تنظیم‌کننده است (Business). تأیید با <details> انجام می‌شود نه confirm()،
               چون CSP اسکریپت inline را اجازه نمی‌دهد و این شکل بدون هیچ جاوااسکریپتی کار می‌کند. *@
            @if (canTrash)
            {
                <details class="relative">
                    <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg border border-outline-variant px-4 text-error hover:bg-error-container/40">
                        <icon name="trash" class="h-5 w-5" />
                        حذف
                    </summary>
                    <div class="absolute end-0 z-20 mt-2 w-72 rounded-xl border border-outline-variant bg-surface-container-lowest p-4 shadow-lg">
                        <p class="text-sm">
                            فرش به <span class="font-semibold">سطل زباله</span> می‌رود. همهٔ اطلاعاتش حفظ می‌شود
                            و هر زمان می‌توانید بازگردانیدش.
                        </p>
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3 flex justify-end">
                            <button type="submit"
                                    class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-error px-4 font-semibold text-on-error hover:opacity-90">
                                <icon name="trash" class="h-5 w-5" />
                                انتقال به سطل زباله
                            </button>
                        </form>
                    </div>
                </details>
            }
        </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
        <!-- ستون راست: مشخصات -->
        <div class="space-y-5 lg:col-span-2">
            @* گالری عکس — آپلود، ترتیب و انتخاب عکس شاخص *@
            <div data-island="rug-gallery" data-skeleton="16rem" data-props='@Json.Serialize(new { rugId = Model.Id })'></div>

            <section class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
                <h3 class="mb-4 flex items-center gap-2 text-sm font-semibold text-primary">
                    <icon name="info" class="h-4 w-4" />
                    مشخصات
                </h3>
                <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm sm:grid-cols-3">
                    <div><dt class="text-on-surface-variant">اصالت</dt><dd>@(Model.Origin ?? "—")</dd></div>
                    <div><dt class="text-on-surface-variant">طرح</dt><dd>@(Model.Pattern ?? "—")</dd></div>
                    <div><dt class="text-on-surface-variant">جنس</dt><dd>@(Model.Material ?? "—")</dd></div>
                    <div>
                        <dt class="text-on-surface-variant">رجشمار</dt>
                        <dd data-numeric>@(Model.KnotDensity.HasValue ? PersianFormat.Count(Model.KnotDensity.Value) : "—")</dd>
                    </div>
                    <div>
                        <dt class="text-on-surface-variant">ابعاد</dt>
                        <dd data-numeric>@PersianFormat.Number(Model.WidthMeters) × @PersianFormat.Number(Model.LengthMeters) متر</dd>
                    </div>
                    <div>
                        <dt class="text-on-surface-variant">مساحت</dt>
                        <dd data-numeric>@PersianFormat.Number(Model.AreaSquareMeters) م²</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="mt-4 rounded-lg bg-surface-container px-4 py-3 text-sm">@Model.Notes</div>
                }
            </section>

            @if (customValues.Count > 0)
            {
                <section class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
                    <h3 class="mb-4 flex items-center gap-2 text-sm font-semibold text-primary">
                        <icon name="settings" class="h-4 w-4" />
                        مشخصات بیشتر
                    </h3>
                    <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm sm:grid-cols-3">
                        @foreach (var kv in customValues)
                        {
                            <div>
                                @if (labels.TryGetValue(kv.Key, out var lbl))
                                {
                                    <dt class="text-on-surface-variant">@lbl</dt>
                                }
                                else
                                {
                                    @* فیلدی که دیگر تعریف نشده؛ فقط در نمای کامل، با کلیدش *@
                                    <dt class="font-mono text-xs text-on-surface-variant" dir="ltr">@kv.Key</dt>
                                }
                                <dd>@kv.Value.ToString()</dd>
                            </div>
                        }
                    </dl>
                </section>
            }
        </div>

        <!-- ستون چپ: مالی و کارهای کارگاه -->
        <div class="space-y-5">
            @if (showMoney && Model.Costs is { } costs)
            {
                <section class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
                    <h3 class="mb-4 text-sm font-semibold text-primary">خلاصهٔ مالی</h3>
                    <dl class="space-y-2 text-sm" data-numeric>
                        <div class="flex justify-between gap-3">
                            <dt class="text-on-surface-variant">قیمت خرید</dt>
                            <dd>@Tenant.Money(costs.PurchaseCost)</dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-on-surface-variant">مجموع هزینهٔ مراحل</dt>
                            <dd>@Tenant.Money(costs.TotalProcessCost)</dd>
                        </div>
                        <div class="flex justify-between gap-3 border-t border-outline-variant pt-2 font-semibold">
                            <dt>سرمایه‌گذاری کل</dt>
                            <dd>@Tenant.Money(costs.TotalInvestment)</dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-on-surface-variant">قیمت فروش هدف</dt>
                            <dd>@Tenant.Money(costs.TargetSalePrice)</dd>
                        </div>

                        @if (costs.ActualProfit is decimal actualProfit)
                        {
                            @* فرش فروخته شده: سود واقعی جای تخمین را می‌گیرد و تخمین فقط برای مقایسه می‌ماند *@
                            <div class="flex justify-between gap-3 border-t border-outline-variant pt-2 font-bold @(actualProfit >= 0 ? "text-success" : "text-error")">
                                <dt>سود واقعی</dt>
                                <dd>@Tenant.Money(actualProfit)</dd>
                            </div>
                            @if (costs.EstimatedMargin is decimal estimated && estimated != actualProfit)
                            {
                                <div class="flex justify-between gap-3 text-xs text-on-surface-variant">
                                    <dt>سود تخمینی (پیش‌بینی)</dt>
                                    <dd>@Tenant.Money(estimated)</dd>
                                </div>
                            }
                        }
                        else if (costs.EstimatedMargin is decimal margin)
                        {
                            <div class="flex justify-between gap-3 font-semibold @(margin >= 0 ? "text-success" : "text-error")">
                                <dt>سود تخمینی</dt>
                                <dd>@Tenant.Money(margin)</dd>
                            </div>
                        }
                    </dl>
                </section>

                @* ثبت/ویرایش فروش و نمایش سود واقعی — فقط Business؛ برای انباردار اصلاً رندر نمی‌شود *@
                <div data-island="rug-sale" data-skeleton="12rem"
                     data-props='@Json.Serialize(new { rugId = Model.Id, totalInvestment = costs.TotalInvestment })'></div>
            }

            @*
                جزیرهٔ کارهای کارگاه: تایم‌لاین، حرکت مراحل با مودال، ویرایش مسیر. در نمای ساده جمع‌شده زیر
                «کارهای کارگاه» می‌آید تا صفحهٔ بازرگان شلوغ نشود؛ در نمای کامل مثل قبل باز است.
            *@
            @if (simple)
            {
                <details class="group">
                    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-xl border border-outline-variant bg-surface-container-lowest px-5 text-sm font-semibold text-primary shadow-sm hover:bg-surface-container">
                        <span class="flex items-center gap-2">
                            <icon name="workflow" class="h-4 w-4" />
                            کارهای کارگاه
                        </span>
                        <icon name="chevron-down" class="h-4 w-4 transition-transform group-open:rotate-180" />
                    </summary>
                    <div class="mt-3">
                        <div data-island="rug-workflow" data-skeleton="20rem" data-props='@Json.Serialize(new { rugId = Model.Id })'></div>
                    </div>
                </details>
            }
            else
            {
                <div data-island="rug-workflow" data-skeleton="20rem" data-props='@Json.Serialize(new { rugId = Model.Id })'></div>
            }
        </div>
    </div>
</div>
