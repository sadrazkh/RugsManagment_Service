@using RugsManagment.Application.DTOs.Rugs
@using RugsManagment.Domain.Enums
@using RugsManagment.Web.Support
@model IReadOnlyList<RugDto>
@{
    ViewData["Title"] = "فرش‌ها";
    var current = ViewData["StatusFilter"] as RugStatus?;
    (string Label, RugStatus? Value)[] filters =
    {
        ("همه", null),
        ("پیش‌نویس", RugStatus.Draft),
        ("در جریان", RugStatus.InProgress),
        ("آمادهٔ فروش", RugStatus.ReadyForSale),
        ("فروخته‌شده", RugStatus.Sold),
    };
}

<div class="space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold">فرش‌ها</h1>
            <p class="text-sm text-on-surface-variant">@PersianFormat.Count(Model.Count) فرش</p>
        </div>
        <a asp-action="Create"
           class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-semibold text-on-primary hover:bg-primary-hover">
            <icon name="plus" class="h-5 w-5" />
            ثبت فرش
        </a>
    </div>

    @* فیلتر وضعیت — هدف لمسی حداقل ۴۴px *@
    <div class="flex flex-wrap gap-2" role="group" aria-label="فیلتر وضعیت">
        @foreach (var (label, value) in filters)
        {
            var isActive = current == value;
            <a asp-action="Index" asp-route-status="@value"
               aria-current="@(isActive ? "true" : null)"
               class="inline-flex min-h-11 items-center rounded-full border px-4 text-sm @(isActive
                   ? "border-primary bg-primary/10 font-semibold text-primary"
                   : "border-outline-variant text-on-surface-variant hover:bg-surface-container")">
                @label
            </a>
        }
    </div>

    @if (Model.Count == 0)
    {
        @* حالت خالی: «هنوز چیزی ثبت نشده» از «این فیلتر نتیجه ندارد» تفکیک شده *@
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest p-12 text-center">
            <span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-surface-container text-on-surface-variant">
                <icon name="rug" class="h-7 w-7" />
            </span>
            @if (current is null)
            {
                <p class="font-medium text-on-surface">هنوز فرشی ثبت نشده است</p>
                <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                    اولین فرش را ثبت کنید تا مسیر گردش کار، هزینه‌ها و برچسب آن ساخته شود.
                </p>
                <a asp-action="Create"
                   class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 font-semibold text-on-primary hover:bg-primary-hover">
                    <icon name="plus" class="h-5 w-5" />
                    ثبت اولین فرش
                </a>
            }
            else
            {
                <p class="font-medium text-on-surface">فرشی با این وضعیت پیدا نشد</p>
                <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                    فیلتر را بردارید تا همهٔ فرش‌ها را ببینید.
                </p>
                <a asp-action="Index"
                   class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-5 hover:bg-surface-container">
                    <icon name="close" class="h-4 w-4" />
                    نمایش همه
                </a>
            }
        </div>
    }
    else
    {
        <!-- موبایل: کارت -->
        <div class="grid gap-3 md:hidden">
            @foreach (var r in Model)
            {
                var st = DisplayHelpers.RugStatus(r.Status);
                <div class="rounded-xl border border-outline-variant bg-surface-container-lowest shadow-sm transition hover:shadow-md">
                    <div class="flex items-start gap-2 p-4">
                        <label class="flex min-h-11 min-w-11 items-start justify-center pt-0.5">
                            <span class="sr-only">انتخاب @r.Sku</span>
                            <input type="checkbox" data-rug-select="@r.Id"
                                   class="h-5 w-5 shrink-0 rounded border-outline-variant text-primary" />
                        </label>
                        <a asp-action="Details" asp-route-id="@r.Id" class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="truncate font-semibold">@(string.IsNullOrEmpty(r.Title) ? "بدون عنوان" : r.Title)</div>
                                    <div class="font-mono text-xs text-on-surface-variant" dir="ltr">@r.Sku</div>
                                </div>
                                <span class="inline-flex shrink-0 items-center gap-1 rounded-full px-2.5 py-1 text-xs @st.Css">
                                    <icon name="@st.Icon" class="h-3.5 w-3.5" />
                                    @st.Label
                                </span>
                            </div>
                            <dl class="mt-3 grid grid-cols-3 gap-2 text-center text-sm" data-numeric>
                                <div>
                                    <dt class="text-xs text-on-surface-variant">ابعاد</dt>
                                    <dd>@PersianFormat.Number(r.WidthMeters)×@PersianFormat.Number(r.LengthMeters)</dd>
                                </div>
                                <div>
                                    <dt class="text-xs text-on-surface-variant">مساحت</dt>
                                    <dd>@PersianFormat.Number(r.AreaSquareMeters) م²</dd>
                                </div>
                                <div>
                                    <dt class="text-xs text-on-surface-variant">مرحله</dt>
                                    <dd class="truncate">@(r.CurrentStepNameFa ?? "—")</dd>
                                </div>
                            </dl>
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- دسکتاپ: جدول -->
        <div class="hidden overflow-x-auto rounded-xl border border-outline-variant bg-surface-container-lowest md:block">
            <table class="w-full min-w-[56rem] text-sm">
                <caption class="sr-only">فهرست فرش‌های کارگاه با وضعیت، ابعاد و هزینه</caption>
                <thead class="bg-surface-container text-on-surface-variant">
                    <tr>
                        <th scope="col" class="w-12 p-3"><span class="sr-only">انتخاب</span></th>
                        <th scope="col" class="p-3 text-right font-medium">کد</th>
                        <th scope="col" class="p-3 text-right font-medium">عنوان</th>
                        <th scope="col" class="p-3 text-right font-medium">ابعاد (متر)</th>
                        <th scope="col" class="p-3 text-right font-medium">مساحت</th>
                        <th scope="col" class="p-3 text-right font-medium">مرحلهٔ جاری</th>
                        <th scope="col" class="p-3 text-right font-medium">وضعیت</th>
                        <th scope="col" class="p-3 text-right font-medium">هزینهٔ کل</th>
                        <th scope="col" class="p-3"><span class="sr-only">عملیات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var st = DisplayHelpers.RugStatus(r.Status);
                        var activeStep = r.WorkflowSteps.FirstOrDefault(x => x.Status == WorkflowStepStatus.InProgress);
                        <tr class="border-t border-outline-variant transition-colors even:bg-surface-container-low/60 hover:bg-surface-container/70">
                            <td class="p-3">
                                <label class="flex min-h-11 min-w-11 items-center justify-center">
                                    <span class="sr-only">انتخاب @r.Sku</span>
                                    <input type="checkbox" data-rug-select="@r.Id"
                                           class="h-5 w-5 rounded border-outline-variant text-primary" />
                                </label>
                            </td>
                            <td class="p-3 font-mono text-xs" dir="ltr">@r.Sku</td>
                            <td class="p-3 font-medium">
                                @* لینک تمام‌ارتفاع سلول تا هدف کلیک به ۴۴px برسد *@
                                <a asp-action="Details" asp-route-id="@r.Id"
                                   class="flex min-h-11 items-center hover:text-primary hover:underline">
                                    @(string.IsNullOrEmpty(r.Title) ? "بدون عنوان" : r.Title)
                                </a>
                            </td>
                            <td class="p-3 whitespace-nowrap">@PersianFormat.Number(r.WidthMeters)×@PersianFormat.Number(r.LengthMeters)</td>
                            <td class="p-3">@PersianFormat.Number(r.AreaSquareMeters)</td>
                            <td class="p-3">@(r.CurrentStepNameFa ?? "—")</td>
                            <td class="p-3">
                                <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs @st.Css">
                                    <icon name="@st.Icon" class="h-3.5 w-3.5" />
                                    @st.Label
                                </span>
                            </td>
                            <td class="p-3 whitespace-nowrap">
                                @PersianFormat.Money(r.Costs.TotalInvestment)
                                <span class="text-xs text-on-surface-variant">تومان</span>
                            </td>
                            <td class="p-3">
                                <div class="flex justify-end gap-1.5">
                                    @if (activeStep is not null)
                                    {
                                        <button type="button" data-advance-rug="@r.Id" data-advance-step="@activeStep.Id"
                                                class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-primary px-3 text-xs text-primary hover:bg-primary/10">
                                            <icon name="check" class="h-4 w-4" />
                                            مرحلهٔ بعد
                                        </button>
                                    }
                                    <a asp-action="Details" asp-route-id="@r.Id"
                                       class="inline-flex min-h-11 items-center rounded-lg border border-outline-variant px-3 text-xs hover:bg-surface-container">
                                        جزئیات
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* جزیرهٔ سبک برای دکمه‌های «مرحلهٔ بعد» داخل لیست *@
        <div data-island="list-quick-advance" data-skeleton="off"></div>
        @* نوار عملیات دسته‌ای (انتخاب چند فرش) *@
        <div data-island="rug-bulk-toolbar" data-skeleton="off"></div>
    }
</div>
