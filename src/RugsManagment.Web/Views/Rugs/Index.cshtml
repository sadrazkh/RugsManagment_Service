@using RugsManagment.Application.DTOs.Rugs
@using RugsManagment.Domain.Enums
@using RugsManagment.Web.Auth
@using RugsManagment.Web.Models.Rugs
@using RugsManagment.Web.Navigation
@using RugsManagment.Web.RugDetails
@using RugsManagment.Web.Support
@model RugListViewModel
@inject IUserPreferencesAccessor Prefs
@{
    ViewData["Title"] = "فرش‌ها";
    var q = Model.Query;
    var result = Model.Result;

    // نمای ساده (بازرگان، انباردار، پیش‌نمایش تنظیم‌کننده): مرحله‌های کارگاه، فیلتر وضعیت کارگاهی و دکمهٔ
    // «مرحلهٔ بعد» پنهان‌اند و کد فرش فقط کوچک زیر شماره می‌آید، نه به‌عنوان ستون اصلی. فقط پوسته است؛ دسترسی‌ها
    // همان می‌ماند.
    var simple = Prefs.IsSimple;

    // مبلغ‌ها فقط برای Business (بازرگان و تنظیم‌کننده). سرویس هم برای انباردار null می‌فرستد؛ این شرط ستون و
    // مرتب‌سازی را هم برمی‌دارد تا جای خالیِ «—» نماند و ترتیبِ «هزینهٔ کل» چیزی لو ندهد.
    var showMoney = Tenant.CanSeeMoney;
    var canTrash = Policies.IsBusiness(User);
    var terms = await AppShell.TermsAsync(Context);

    // سرستون‌های قابل مرتب‌سازی: عنوان نمایشی + ستون منطقی. «شماره» ستون اول است (A.2).
    var sortableHeaders = new List<(string Label, RugSortBy Column)> { ("شماره", RugSortBy.Serial) };
    if (!simple) sortableHeaders.Add(("کد", RugSortBy.Sku));
    sortableHeaders.Add(("عنوان", RugSortBy.Title));
    sortableHeaders.Add(("متراژ", RugSortBy.Area));
    if (!simple)
    {
        sortableHeaders.Add(("مرحلهٔ جاری", RugSortBy.CurrentStep));
        sortableHeaders.Add(("وضعیت", RugSortBy.Status));
    }
    if (showMoney) sortableHeaders.Add(("هزینهٔ کل", RugSortBy.TotalCost));

    var advancedOpen = q.BatchId.HasValue || q.WithoutBatch || (!simple && q.StepTypeId.HasValue)
                       || q.CreatedFrom.HasValue || q.CreatedTo.HasValue || !string.IsNullOrWhiteSpace(q.Serial);

    // چیپ‌های جا (C.10، H.1): «در انبار»، «در نگله»، «صادر شده»، «فروخته‌شده» — از فاز ۴b که محموله و نگله هست، همیشه هر
    // چهار. «در نگله» واژهٔ کارگاه را می‌گیرد (عدل).
    var locationChips = new List<RugLocation> { RugLocation.InStock, RugLocation.InBale, RugLocation.Exported, RugLocation.Sold };

    // متن چیپ «جا»ی یک ردیف: «در نگلهٔ ۳» با شمارهٔ نگله، و برای فرش داخل محموله شمارهٔ محموله کنارش
    string LocationText(RugListItemDto r) => r.Location == RugLocation.InBale && r.BaleNumber is { } bale
        ? $"در {terms.BaleOf} {PersianFormat.Count(bale)}"
        : RugDetailsFormat.LocationLabel(r.Location, terms.Bale);
    string? ShipmentText(RugListItemDto r) => r.Location is RugLocation.InBale or RugLocation.Exported && r.ShipmentNumber is { } n
        ? $"محمولهٔ {PersianFormat.Count(n)}"
        : null;

    // نمای جدول (فاز ۳، جزیرهٔ rugs-grid): همان فیلترهای آدرس، به‌صورت جدول اکسل‌مانند؛ «?view=grid» در آدرس می‌ماند
    var gridView = string.Equals(Context.Request.Query["view"], "grid", StringComparison.OrdinalIgnoreCase);
    var gridQuery = Context.Request.Query
        .Where(p => !string.Equals(p.Key, "view", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(p.Key, "page", StringComparison.OrdinalIgnoreCase))
        .ToDictionary(p => p.Key, p => p.Value.ToString(), StringComparer.Ordinal);
    var toggleView = QueryString.Create(Context.Request.Query
        .Where(p => !string.Equals(p.Key, "view", StringComparison.OrdinalIgnoreCase))
        .Select(p => new KeyValuePair<string, string?>(p.Key, p.Value.ToString()))
        .Concat(gridView
            ? Array.Empty<KeyValuePair<string, string?>>()
            : new[] { new KeyValuePair<string, string?>("view", "grid") }));
}

<div class="space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold">فرش‌ها</h1>
            <p class="text-sm text-on-surface-variant" data-numeric>
                @PersianFormat.Count(result.TotalCount) ردیف
                @if (q.HasActiveFilters)
                {
                    <text>با فیلتر فعال</text>
                }
            </p>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (canTrash)
            {
                <a asp-action="Trash"
                   class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-4 hover:bg-surface-container">
                    <icon name="trash" class="h-5 w-5" />
                    سطل زباله
                </a>
            }
            @* «جدول» / «فهرست»: همان فرش‌ها و فیلترها در نمای جدول اکسل‌مانند، یا برگشت به فهرست *@
            <a href="/Rugs@(toggleView)"
               class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-4 hover:bg-surface-container">
                <icon name="@(gridView ? "rug" : "spreadsheet")" class="h-5 w-5" />
                @(gridView ? "فهرست" : "جدول")
            </a>
            @* «ثبت فرش تازه» از فاز ۳ جدول ورود است (A.2)؛ فرم تک‌فرش هنوز از «ثبت اولین فرش» و جزئیات در دسترس است *@
            <a href="/Intake"
               class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-semibold text-on-primary hover:bg-primary-hover">
                <icon name="plus" class="h-5 w-5" />
                ثبت فرش تازه
            </a>
        </div>
    </div>

    @*
        همهٔ فیلترها در یک فرم GET هستند تا وضعیت در آدرس بنشیند:
        قابل اشتراک، bookmark و سازگار با دکمهٔ back مرورگر. فیلترهایی که در فرم خانه ندارند (location، shipmentId،
        baleId، notBaled، «بی ورودی») با input مخفی می‌مانند تا جستجوی تازه آن‌ها را بی‌صدا نیندازد.
    *@
    <form method="get" asp-action="Index" id="rug-filters" class="space-y-3" data-no-print>
        @* مرتب‌سازی فعلی هنگام جستجو حفظ می‌شود *@
        @if (q.SortBy != RugSortBy.CreatedAt)
        {
            <input type="hidden" name="sortBy" value="@q.SortBy" />
        }
        @if (!q.Descending)
        {
            <input type="hidden" name="descending" value="false" />
        }
        @* در نمای ساده فیلتر وضعیت دیده نمی‌شود ولی اگر از لینکی آمده باشد حفظ می‌شود *@
        @if (simple && q.Status.HasValue)
        {
            <input type="hidden" name="status" value="@q.Status" />
        }
        @if (q.Location.HasValue)
        {
            <input type="hidden" name="location" value="@q.Location" />
        }
        @if (q.ShipmentId.HasValue)
        {
            <input type="hidden" name="shipmentId" value="@q.ShipmentId" />
        }
        @if (q.BaleId.HasValue)
        {
            <input type="hidden" name="baleId" value="@q.BaleId" />
        }
        @if (q.NotBaled)
        {
            <input type="hidden" name="notBaled" value="true" />
        }
        @if (q.PageSize != RugQuery.DefaultPageSize)
        {
            <input type="hidden" name="pageSize" value="@q.PageSize" />
        }
        @if (gridView)
        {
            <input type="hidden" name="view" value="grid" />
        }

        <div class="flex flex-wrap gap-3">
            <div class="relative min-w-64 flex-1">
                <label for="rug-search" class="sr-only">جستجو در فرش‌ها</label>
                <span class="pointer-events-none absolute inset-y-0 right-3 grid place-items-center text-on-surface-variant">
                    <icon name="search" />
                </span>
                <input type="search" id="rug-search" name="search" value="@q.Search"
                       placeholder="جستجو در شماره، عنوان، محل بافت، نقشه، مواد، کد یا یادداشت…"
                       autocomplete="off"
                       data-autosubmit
                       class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest pe-11 ps-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
            </div>

            <button type="submit"
                    class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-4 hover:bg-surface-container">
                <icon name="search" class="h-4 w-4" />
                جستجو
            </button>

            @if (q.HasActiveFilters)
            {
                <a asp-action="Index"
                   class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-4 text-on-surface-variant hover:bg-surface-container">
                    <icon name="close" class="h-4 w-4" />
                    حذف فیلترها
                </a>
            }
        </div>

        @* جای فرش (C.10): در انبار، فروخته‌شده، … — برای همه، در هر دو نما *@
        <div class="flex flex-wrap gap-2" role="group" aria-label="فیلتر جای فرش">
            <a asp-action="Index" asp-all-route-data="Model.LocationRoute(null)"
               aria-current="@(Model.IsLocation(null) ? "true" : null)"
               class="inline-flex min-h-11 items-center rounded-full border px-4 text-sm @(Model.IsLocation(null)
                   ? "border-primary bg-primary/10 font-semibold text-primary"
                   : "border-outline-variant text-on-surface-variant hover:bg-surface-container")">
                همه
            </a>
            @foreach (var location in locationChips)
            {
                var active = Model.IsLocation(location);
                <a asp-action="Index" asp-all-route-data="Model.LocationRoute(location)"
                   aria-current="@(active ? "true" : null)"
                   class="inline-flex min-h-11 items-center gap-1.5 rounded-full border px-4 text-sm @(active
                       ? "border-primary bg-primary/10 font-semibold text-primary"
                       : "border-outline-variant text-on-surface-variant hover:bg-surface-container")">
                    <icon name="@RugDetailsFormat.LocationIcon(location)" class="h-4 w-4" />
                    @RugDetailsFormat.LocationLabel(location, terms.Bale)
                </a>
            }
        </div>

        @* فیلتر وضعیت کارگاهی — فقط نمای کامل *@
        @if (!simple)
        {
            <div class="flex flex-wrap gap-2" role="group" aria-label="فیلتر وضعیت">
                @{
                    var allActive = q.Status is null;
                    var allStatusRoute = Model.WithFilter("status", null);
                }
                <a asp-action="Index" asp-all-route-data="allStatusRoute"
                   aria-current="@(allActive ? "true" : null)"
                   class="inline-flex min-h-11 items-center rounded-full border px-4 text-sm @(allActive
                       ? "border-primary bg-primary/10 font-semibold text-primary"
                       : "border-outline-variant text-on-surface-variant hover:bg-surface-container")">
                    همهٔ وضعیت‌ها
                </a>
                @foreach (var status in DisplayHelpers.RugStatusOrder)
                {
                    var isActive = q.Status == status;
                    var statusRoute = Model.WithFilter("status", status.ToString());
                    <a asp-action="Index" asp-all-route-data="statusRoute"
                       aria-current="@(isActive ? "true" : null)"
                       class="inline-flex min-h-11 items-center rounded-full border px-4 text-sm @(isActive
                           ? "border-primary bg-primary/10 font-semibold text-primary"
                           : "border-outline-variant text-on-surface-variant hover:bg-surface-container")">
                        @DisplayHelpers.RugStatus(status).Label
                    </a>
                }
            </div>
        }

        @* فیلترهای کم‌کاربردتر پشت یک آکاردئون — جلوگیری از شلوغی بصری *@
        <details class="rounded-lg border border-outline-variant bg-surface-container-lowest" @(advancedOpen ? "open" : "")>
            <summary class="flex min-h-11 items-center gap-2 px-4 text-sm font-medium text-on-surface-variant">
                <icon name="filter" class="h-4 w-4" />
                فیلترهای بیشتر
            </summary>
            <div class="grid gap-3 border-t border-outline-variant p-4 sm:grid-cols-2 lg:grid-cols-4">
                <label class="block">
                    <span class="mb-1 block text-sm">شمارهٔ دقیق</span>
                    @* «3925» دسته‌ای را هم پیدا می‌کند که این شماره داخلش است؛ «3911 - 3960» همپوشانی‌ها را *@
                    <input type="text" name="serial" value="@q.Serial" dir="ltr" inputmode="numeric" autocomplete="off"
                           placeholder="3778 یا 3911 - 3960"
                           class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 text-end outline-none focus:border-primary" />
                </label>

                <label class="block">
                    <span class="mb-1 block text-sm">ورودی</span>
                    <select name="batchId"
                            class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary">
                        <option value="">همهٔ ورودی‌ها</option>
                        @foreach (var b in Model.Batches)
                        {
                            <option value="@b.Id" selected="@(q.BatchId == b.Id)">@b.Name</option>
                        }
                    </select>
                </label>

                <label class="flex min-h-11 items-center gap-2 self-end">
                    <input type="checkbox" name="withoutBatch" value="true" checked="@q.WithoutBatch"
                           class="h-5 w-5 rounded border-outline-variant text-primary" />
                    <span class="text-sm">فقط فرش‌های بی‌ورودی</span>
                </label>

                @if (!simple)
                {
                    <label class="block">
                        <span class="mb-1 block text-sm">مرحلهٔ جاری</span>
                        <select name="stepTypeId"
                                class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary">
                            <option value="">همهٔ مراحل</option>
                            @foreach (var s in Model.StepTypes)
                            {
                                <option value="@s.Id" selected="@(q.StepTypeId == s.Id)">@s.NameFa</option>
                            }
                        </select>
                    </label>
                }
                else if (q.StepTypeId.HasValue)
                {
                    <input type="hidden" name="stepTypeId" value="@q.StepTypeId" />
                }

                <label class="block">
                    <span class="mb-1 block text-sm">ثبت از تاریخ</span>
                    <input type="date" name="createdFrom" dir="ltr" value="@Model.CreatedFromText"
                           class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary" />
                </label>

                <label class="block">
                    <span class="mb-1 block text-sm">تا تاریخ</span>
                    <input type="date" name="createdTo" dir="ltr" value="@Model.CreatedToText"
                           class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary" />
                </label>

                <div class="sm:col-span-2 lg:col-span-4">
                    <button type="submit"
                            class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 font-semibold text-on-primary hover:bg-primary-hover">
                        <icon name="check" class="h-4 w-4" />
                        اعمال فیلترها
                    </button>
                </div>
            </div>
        </details>
    </form>

    @if (gridView)
    {
        @* جدول فرش‌ها (GET /api/grid/rugs با همین فیلترها)؛ ذخیره از POST /api/grid/rugs/batch *@
        <div data-island="rugs-grid" data-skeleton="30rem" data-hotkeys-off
             data-props='@Json.Serialize(new { query = gridQuery })'></div>
    }
    else if (result.TotalCount == 0)
    {
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest p-12 text-center">
            <span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-surface-container text-on-surface-variant">
                <icon name="@(q.HasActiveFilters ? "search" : "rug")" class="h-7 w-7" />
            </span>

            @if (!q.HasActiveFilters)
            {
                <p class="font-medium text-on-surface">هنوز فرشی ثبت نشده است</p>
                <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                    اولین فرش را ثبت کنید؛ بعد می‌توانید برچسبش را چاپ کنید.
                </p>
                <a asp-action="Create"
                   class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 font-semibold text-on-primary hover:bg-primary-hover">
                    <icon name="plus" class="h-5 w-5" />
                    ثبت اولین فرش
                </a>
            }
            else
            {
                <p class="font-medium text-on-surface">
                    @if (!string.IsNullOrWhiteSpace(q.Search))
                    {
                        <text>چیزی برای «@q.Search» پیدا نشد</text>
                    }
                    else if (!string.IsNullOrWhiteSpace(q.Serial))
                    {
                        <text>فرشی با شمارهٔ «<bdi dir="ltr">@q.Serial</bdi>» پیدا نشد</text>
                    }
                    else
                    {
                        <text>فرشی با این فیلترها پیدا نشد</text>
                    }
                </p>
                <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                    املای عبارت را بررسی کنید، بخشی از شماره یا عنوان را جستجو کنید، یا فیلترها را بردارید.
                </p>
                <a asp-action="Index"
                   class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg border border-outline-variant px-5 hover:bg-surface-container">
                    <icon name="close" class="h-4 w-4" />
                    حذف همهٔ فیلترها
                </a>
            }
        </div>
    }
    else
    {
        <!-- موبایل: کارت -->
        <div class="grid gap-3 md:hidden">
            @foreach (var r in result.Items)
            {
                var st = DisplayHelpers.RugStatus(r.Status, simple);
                <div class="rounded-xl border border-outline-variant bg-surface-container-lowest shadow-sm transition hover:shadow-md">
                    <div class="flex items-start gap-2 p-4">
                        <label class="flex min-h-11 min-w-11 items-start justify-center pt-0.5">
                            <span class="sr-only">انتخاب @(r.SerialNo ?? r.Sku)</span>
                            <input type="checkbox" data-rug-select="@r.Id"
                                   class="h-5 w-5 shrink-0 rounded border-outline-variant text-primary" />
                        </label>
                        <a asp-action="Details" asp-route-id="@r.Id" class="flex min-w-0 flex-1 gap-3">
                            @* اندازه ثابت است تا نبودِ عکس باعث پرش چیدمان نشود *@
                            <span class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-lg bg-surface-container text-on-surface-variant">
                                @if (r.ThumbnailUrl is string thumb)
                                {
                                    <img src="@thumb" alt="" width="64" height="64" loading="lazy" decoding="async"
                                         class="h-full w-full object-cover" />
                                }
                                else
                                {
                                    <icon name="image" class="h-6 w-6" />
                                }
                            </span>
                            <span class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="truncate font-semibold">
                                        @if (r.SerialNo is not null)
                                        {
                                            <bdi dir="ltr" data-numeric>@PersianFormat.ToPersianDigits(r.SerialNo)</bdi>
                                        }
                                        else
                                        {
                                            @(string.IsNullOrEmpty(r.Title) ? "بدون عنوان" : r.Title)
                                        }
                                    </div>
                                    <div class="truncate text-xs text-on-surface-variant">
                                        @if (r.SerialNo is not null && !string.IsNullOrEmpty(r.Title))
                                        {
                                            <span>@r.Title ·</span>
                                        }
                                        <span class="font-mono" dir="ltr">@r.Sku</span>
                                    </div>
                                </div>
                                @if (simple)
                                {
                                    @* نمای ساده: به‌جای وضعیت کارگاهی فقط «جا» (A.3) *@
                                    <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-surface-container px-2.5 py-1 text-xs" data-numeric data-rug-location="@r.Location">
                                        <icon name="@RugDetailsFormat.LocationIcon(r.Location)" class="h-3.5 w-3.5" />
                                        @LocationText(r)
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex shrink-0 items-center gap-1 rounded-full px-2.5 py-1 text-xs @st.Css">
                                        <icon name="@st.Icon" class="h-3.5 w-3.5" />
                                        @st.Label
                                    </span>
                                }
                            </div>
                            @if (!simple || ShipmentText(r) is not null)
                            {
                                <p class="mt-1 flex flex-wrap items-center gap-1.5 text-xs text-on-surface-variant" data-numeric>
                                    @if (!simple)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-surface-container px-2 py-0.5" data-rug-location="@r.Location">
                                            <icon name="@RugDetailsFormat.LocationIcon(r.Location)" class="h-3.5 w-3.5" />
                                            @LocationText(r)
                                        </span>
                                    }
                                    @if (ShipmentText(r) is { } shipmentText)
                                    {
                                        <span>@shipmentText</span>
                                    }
                                </p>
                            }
                            <dl class="mt-3 grid @(simple ? "grid-cols-2" : "grid-cols-3") gap-2 text-center text-sm" data-numeric>
                                <div>
                                    <dt class="text-xs text-on-surface-variant">اندازه</dt>
                                    <dd><bdi dir="ltr">@RugDetailsFormat.Size(r.LengthMeters, r.WidthMeters)</bdi></dd>
                                </div>
                                <div>
                                    <dt class="text-xs text-on-surface-variant">@(r.Quantity > 1 ? $"متراژ ({PersianFormat.Count(r.Quantity)} تخته)" : "متراژ")</dt>
                                    <dd>@RugDetailsFormat.Decimal2(r.TotalAreaM2) م²</dd>
                                </div>
                                @if (!simple)
                                {
                                    <div>
                                        <dt class="text-xs text-on-surface-variant">مرحله</dt>
                                        <dd class="truncate">@(r.CurrentStepNameFa ?? "—")</dd>
                                    </div>
                                }
                            </dl>
                            @if (showMoney)
                            {
                                <p class="mt-2 text-sm" data-numeric>
                                    @PersianFormat.Money(r.TotalInvestment)
                                    <span class="text-xs text-on-surface-variant">@Tenant.Currency</span>
                                </p>
                            }
                            </span>
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- دسکتاپ: جدول -->
        <div class="relative hidden overflow-x-auto rounded-xl border border-outline-variant bg-surface-container-lowest md:block">
            <table class="w-full @(simple ? "min-w-[44rem]" : "min-w-[60rem]") text-sm">
                <caption class="sr-only">فهرست فرش‌های کارگاه — سرستون‌ها برای مرتب‌سازی قابل کلیک‌اند</caption>
                <thead class="bg-surface-container text-on-surface-variant">
                    <tr>
                        <th scope="col" class="w-12 p-3"><span class="sr-only">انتخاب</span></th>
                        <th scope="col" class="w-16 p-3"><span class="sr-only">عکس</span></th>
                        @foreach (var (label, column) in sortableHeaders)
                        {
                            <th scope="col" class="p-0 text-right font-medium" aria-sort="@Model.AriaSort(column)">
                                <a asp-action="Index" asp-all-route-data="Model.SortRoute(column)"
                                   class="flex min-h-11 items-center gap-1 px-3 hover:text-primary">
                                    @label
                                    @if (Model.SortIcon(column) is string icon)
                                    {
                                        <icon name="@icon" class="h-4 w-4 text-primary" />
                                    }
                                </a>
                            </th>
                            @if (column == RugSortBy.Area)
                            {
                                @* «جا» (C.10) در هر دو نما؛ نمای ساده به‌جای وضعیت کارگاهی فقط همین را دارد (A.3) *@
                                <th scope="col" class="p-3 text-right font-medium">جا</th>
                            }
                        }
                        <th scope="col" class="p-3"><span class="sr-only">عملیات</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in result.Items)
                    {
                        var st = DisplayHelpers.RugStatus(r.Status, simple);
                        <tr class="border-t border-outline-variant transition-colors even:bg-surface-container-low/60 hover:bg-surface-container/70">
                            <td class="p-3">
                                <label class="flex min-h-11 min-w-11 items-center justify-center">
                                    <span class="sr-only">انتخاب @(r.SerialNo ?? r.Sku)</span>
                                    <input type="checkbox" data-rug-select="@r.Id"
                                           class="h-5 w-5 rounded border-outline-variant text-primary" />
                                </label>
                            </td>
                            <td class="p-3">
                                @* اندازهٔ ثابت: ردیف‌های بی‌عکس نباید ارتفاع جدول را ناهمگون کنند *@
                                <span class="grid h-11 w-11 place-items-center overflow-hidden rounded-lg bg-surface-container text-on-surface-variant">
                                    @if (r.ThumbnailUrl is string thumb)
                                    {
                                        <img src="@thumb" alt="" width="44" height="44" loading="lazy" decoding="async"
                                             class="h-full w-full object-cover" />
                                    }
                                    else
                                    {
                                        <icon name="image" class="h-4 w-4" />
                                    }
                                </span>
                            </td>
                            <td class="p-3 whitespace-nowrap font-semibold" data-numeric>
                                <a asp-action="Details" asp-route-id="@r.Id" class="flex min-h-11 items-center gap-2 hover:text-primary hover:underline">
                                    @if (r.SerialNo is not null)
                                    {
                                        <bdi dir="ltr">@PersianFormat.ToPersianDigits(r.SerialNo)</bdi>
                                    }
                                    else
                                    {
                                        <span class="font-normal text-on-surface-variant">—</span>
                                    }
                                    @if (r.Quantity > 1)
                                    {
                                        <span class="rounded-full bg-secondary/15 px-2 py-0.5 text-xs font-normal">@PersianFormat.Count(r.Quantity) تخته</span>
                                    }
                                </a>
                            </td>
                            @if (!simple)
                            {
                                <td class="p-3 font-mono text-xs" dir="ltr">@r.Sku</td>
                            }
                            <td class="p-3 font-medium">
                                @* لینک تمام‌ارتفاع سلول تا هدف کلیک به ۴۴px برسد *@
                                <a asp-action="Details" asp-route-id="@r.Id"
                                   class="flex min-h-11 flex-col justify-center hover:text-primary hover:underline">
                                    <span>@(string.IsNullOrEmpty(r.Title) ? "بدون عنوان" : r.Title)</span>
                                    @if (simple)
                                    {
                                        @* کد فرش در نمای ساده فقط کوچک، هرگز ستون اصلی *@
                                        <span class="font-mono text-xs font-normal text-on-surface-variant" dir="ltr">@r.Sku</span>
                                    }
                                </a>
                            </td>
                            <td class="p-3 whitespace-nowrap" data-numeric>
                                @RugDetailsFormat.Decimal2(r.TotalAreaM2)
                                <span class="text-xs text-on-surface-variant">م²</span>
                            </td>
                            <td class="p-3" data-numeric>
                                <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full bg-surface-container px-2.5 py-1 text-xs" data-rug-location="@r.Location">
                                    <icon name="@RugDetailsFormat.LocationIcon(r.Location)" class="h-3.5 w-3.5" />
                                    @LocationText(r)
                                </span>
                                @if (ShipmentText(r) is { } shipmentText)
                                {
                                    <span class="mt-0.5 block text-xs text-on-surface-variant">@shipmentText</span>
                                }
                            </td>
                            @if (!simple)
                            {
                                <td class="p-3">@(r.CurrentStepNameFa ?? "—")</td>
                                <td class="p-3">
                                    <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs @st.Css">
                                        <icon name="@st.Icon" class="h-3.5 w-3.5" />
                                        @st.Label
                                    </span>
                                </td>
                            }
                            @if (showMoney)
                            {
                                <td class="p-3 whitespace-nowrap" data-numeric>
                                    @PersianFormat.Money(r.TotalInvestment)
                                    <span class="text-xs text-on-surface-variant">@Tenant.Currency</span>
                                </td>
                            }
                            <td class="p-3">
                                <div class="flex justify-end gap-1.5">
                                    @if (!simple && r.ActiveStepId is Guid stepId)
                                    {
                                        <button type="button" data-advance-rug="@r.Id" data-advance-step="@stepId"
                                                data-advance-label="@(r.SerialNo ?? r.Sku)"
                                                class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-primary px-3 text-xs text-primary hover:bg-primary/10">
                                            <icon name="check" class="h-4 w-4" />
                                            مرحلهٔ بعد
                                        </button>
                                    }
                                    <a asp-action="Details" asp-route-id="@r.Id"
                                       class="inline-flex min-h-11 items-center rounded-lg border border-outline-variant px-3 text-xs hover:bg-surface-container">
                                        جزئیات
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pager" model="Model" />

        @if (!simple)
        {
            @* جزیرهٔ سبک برای دکمه‌های «مرحلهٔ بعد» داخل لیست (فقط نمای کامل) *@
            <div data-island="list-quick-advance" data-skeleton="off"></div>
        }
        @* نوار عملیات دسته‌ای (انتخاب چند فرش)؛ پنهان کردن کارهای کارگاهی در نمای ساده با خود جزیره است *@
        <div data-island="rug-bulk-toolbar" data-skeleton="off"></div>
    }
</div>
