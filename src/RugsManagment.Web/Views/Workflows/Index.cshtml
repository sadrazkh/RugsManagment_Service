@using System.Security.Claims
@using RugsManagment.Application.DTOs.Workflows
@model IReadOnlyList<WorkflowTemplateDto>
@{
    ViewData["Title"] = "گردش کار";
    var isAdmin = User.FindFirstValue(ClaimTypes.Role) == nameof(RugsManagment.Domain.Enums.UserRole.TenantAdmin);
}

<div class="space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold">قالب‌های گردش کار</h1>
            <p class="text-sm text-on-surface-variant">مسیرهای آمادهٔ فرایند که هنگام ثبت فرش انتخاب می‌شوند</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create"
               class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 font-semibold text-on-primary hover:bg-primary-hover">
                <icon name="plus" class="h-5 w-5" />
                قالب جدید
            </a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest p-12 text-center">
            <span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-surface-container text-on-surface-variant">
                <icon name="workflow" class="h-7 w-7" />
            </span>
            <p class="font-medium text-on-surface">هنوز قالبی تعریف نشده است</p>
            <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                یک مسیر استاندارد (مثلاً قالیشویی ← رفوگری ← دارکشی) بسازید تا هنگام ثبت فرش فقط انتخابش کنید.
            </p>
            @if (isAdmin)
            {
                <a asp-action="Create"
                   class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 font-semibold text-on-primary hover:bg-primary-hover">
                    <icon name="plus" class="h-5 w-5" />
                    ساخت اولین قالب
                </a>
            }
        </div>
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (var t in Model)
            {
                <div class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm transition hover:shadow-md">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h2 class="flex flex-wrap items-center gap-2 font-bold">
                                @t.Name
                                @if (t.IsDefault)
                                {
                                    <span class="rounded-full bg-secondary-container px-2 py-0.5 text-xs font-normal text-on-secondary-container">پیش‌فرض</span>
                                }
                            </h2>
                            @if (!string.IsNullOrEmpty(t.Description))
                            {
                                <p class="text-sm text-on-surface-variant">@t.Description</p>
                            }
                        </div>
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@t.Id"
                               class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-lg border border-outline-variant px-3 text-xs hover:bg-surface-container">
                                <icon name="edit" class="h-4 w-4" />
                                ویرایش
                            </a>
                        }
                    </div>

                    @* مسیر مراحل — در RTL جهت جریان از راست به چپ است *@
                    <ol class="mt-4 flex flex-wrap items-center gap-1.5 text-sm">
                        @for (var i = 0; i < t.Steps.Count; i++)
                        {
                            var s = t.Steps[i];
                            <li class="rounded-lg bg-surface-container px-2.5 py-1 @(s.IsOptional ? "border border-dashed border-outline" : "")"
                                title="@(s.IsOptional ? "مرحلهٔ اختیاری" : "مرحلهٔ اجباری")">
                                @s.StepNameFa
                            </li>
                            @if (i < t.Steps.Count - 1)
                            {
                                <icon name="arrow-left" class="h-4 w-4 text-on-surface-variant" />
                            }
                        }
                    </ol>
                </div>
            }
        </div>
    }
</div>
