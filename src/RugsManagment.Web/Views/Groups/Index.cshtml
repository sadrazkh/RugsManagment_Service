@using RugsManagment.Application.DTOs.Batches
@using RugsManagment.Web.Support
@model IReadOnlyList<RugBatchDto>
@{
    ViewData["Title"] = "گروه‌ها";
}

<div class="space-y-5">
    <div>
        <h1 class="text-2xl font-bold">گروه‌ها / محموله‌ها</h1>
        <p class="text-sm text-on-surface-variant">فرش‌هایی که با هم پیش می‌روند (مثلاً محمولهٔ یک روز)</p>
    </div>

    <!-- ساخت گروه -->
    <form asp-action="Create" method="post"
          class="flex flex-wrap items-end gap-3 rounded-xl border border-outline-variant bg-surface-container-lowest p-4 shadow-sm">
        @Html.AntiForgeryToken()
        <label class="block flex-1">
            <span class="mb-1 block text-sm">نام گروه</span>
            <input name="name" required placeholder="محمولهٔ ۱۴۰۵/۰۵/۰۵"
                   class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
        </label>
        <label class="block flex-1">
            <span class="mb-1 block text-sm">توضیح</span>
            <input name="description"
                   class="min-h-11 w-full rounded-lg border border-outline-variant bg-surface-container-lowest px-3 outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
        </label>
        <button type="submit"
                class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-5 font-semibold text-on-primary hover:bg-primary-hover">
            <icon name="plus" class="h-5 w-5" />
            ساخت گروه
        </button>
    </form>

    @if (Model.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-outline-variant bg-surface-container-lowest p-12 text-center">
            <span class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-surface-container text-on-surface-variant">
                <icon name="package" class="h-7 w-7" />
            </span>
            <p class="font-medium text-on-surface">هنوز گروهی ساخته نشده است</p>
            <p class="mx-auto mt-1 max-w-sm text-sm text-on-surface-variant">
                با فرم بالا یک گروه بسازید تا چند فرش را با هم در مسیر گردش کار پیش ببرید.
            </p>
        </div>
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var b in Model)
            {
                <a asp-action="Details" asp-route-id="@b.Id"
                   class="block rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm transition hover:border-primary hover:shadow-md">
                    <div class="flex items-start justify-between gap-2">
                        <h2 class="min-w-0 truncate font-bold">@b.Name</h2>
                        <span class="shrink-0 rounded-full bg-secondary-container px-2.5 py-1 text-xs text-on-secondary-container" data-numeric>
                            @PersianFormat.Count(b.RugCount) فرش
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(b.Description))
                    {
                        <p class="mt-1 text-sm text-on-surface-variant">@b.Description</p>
                    }
                    @if (!string.IsNullOrEmpty(b.CurrentStepSummary))
                    {
                        <p class="mt-3 flex items-center gap-1.5 text-xs text-on-surface-variant">
                            <icon name="workflow" class="h-3.5 w-3.5" />
                            مراحل جاری: @b.CurrentStepSummary
                        </p>
                    }
                </a>
            }
        </div>
    }
</div>
