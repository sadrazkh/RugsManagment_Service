{
  "schemaVersion": 1,
  "about": "Shared rounding vectors (spec G.4 / L.1). Run by xUnit (Domain Num/AreaMath) and vitest (lib/num.ts). Decimals are strings so neither side reads them through a float; 'raw' values are deliberate floats. Rounding is always half away from zero; a lot is rounded per piece, then multiplied by qty.",
  "ops": {
    "round": "round(value, scale)",
    "snap": "parse the float 'raw', round to scale (cleans Excel noise such as 2.2999999999999998)",
    "pieceArea": "piece = round(round(length,2) * round(width,2), 2); line = piece * qty",
    "snapArea": "length/width given as floats (raw); snap each to 2 dp, then pieceArea",
    "pieceUsd": "piece = round(area * rate, 2); line = piece * qty",
    "pieceMoney": "piece = round(rate * area, scale); line = piece * qty",
    "perPiece": "piece = round(rate, scale); line = piece * qty",
    "convertPiece": "piece = round(amount * rate, scale); line = piece * qty (FX applied per piece, never to the line total)"
  },
